{
  "name": "resolveai",
  "private": true,
  "workspaces": ["apps/web", "packages/api-client", "infra"],
  "scripts": {
    "web:dev": "npm --workspace @resolveai/web run dev",
    "web:build": "npm --workspace @resolveai/web run build",
    "web:typecheck": "npm --workspace @resolveai/web run typecheck",
    "web:lint": "npm --workspace @resolveai/web run lint",
    "api:test": "cd apps/api && python -m pytest",
    "api:lint": "cd apps/api && python -m ruff check .",
    "api:typecheck": "cd apps/api && python -m mypy app",
    "contract:generate": "cd apps/api && python -m app.export_openapi",
    "infra:synth": "npm --workspace @resolveai/infra run synth",
    "test": "npm run api:test && npm run web:typecheck"
  },
  "engines": { "node": ">=22.14.0" }
}
